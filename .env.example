# --- Core -------------------------------------------------------------------
NODE_ENV=production
PORT=4000

# --- Database ---------------------------------------------------------------  
POSTGRES_DB=personal_ai
POSTGRES_USER=personal_ai
POSTGRES_PASSWORD=replace-with-a-long-random-password

DEFAULT_USER_ID=00000000-0000-4000-8000-000000000001
JWT_SECRET=replace-with-at-least-32-random-characters

AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=30000

MEMORY_ENABLED=true
MEMORY_RETRIEVAL_ENABLED=true
MEMORY_MAX_ITEMS=8
MEMORY_MIN_SCORE=0.65
MEMORY_MAX_CONTEXT_TOKENS=1500
MEMORY_AUTO_SAVE_ENABLED=true
MEMORY_CONFIRMATION_ENABLED=true

BODY_LIMIT=100kb
AGENT_RATE_LIMIT_PER_MINUTE=20
CORS_ORIGINS=https://your-frontend.example.com

# --- Production Compose -----------------------------------------------------
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=4000